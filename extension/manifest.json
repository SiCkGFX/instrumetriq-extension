{
  "manifest_version": 3,
  "name": "Instrumetriq - Crypto Sentiment & Market Pulse",
  "version": "2.0.1",
  "description": "See which crypto coins are suddenly drawing unusual conversation on X, and what people are saying about them.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "alarms",
    "storage",
    "activeTab"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "host_permissions": [
    "https://extensionpay.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "extensionpay.js"
      ],
      "matches": [
        "https://extensionpay.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://extensionpay.com/*"
      ],
      "js": [
        "extensionpay.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}