{
  "manifest_version": 3,
  "name": "Instrumetriq - Crypto Sentiment & Market Pulse",
  "version": "1.0.12",
  "description": "X (Twitter) chatter levels and tone shifts for 257 crypto coins. Funding rates, open interest, and whale positioning - one popup.",

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "alarms",
    "storage",
    "notifications",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://api.instrumetriq.com/*",
    "https://extensionpay.com/*"
  ],

  "web_accessible_resources": [
    {
      "resources": ["extensionpay.js"],
      "matches": ["https://extensionpay.com/*"]
    }
  ],

  "content_scripts": [
    {
      "matches": ["https://extensionpay.com/*"],
      "js": ["extensionpay.js"],
      "run_at": "document_start"
    }
  ],

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
