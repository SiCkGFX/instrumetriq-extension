# ── Secrets - NEVER commit these ─────────────────────────────────────────────
# Bearer token injected at build time
extension/secrets.js

# ── Generated / runtime data ─────────────────────────────────────────────────
# NOTHING under data/ is public. Per-coin CSVs are raw per-cycle sentiment, and
# listing directories one by one meant a new one (coins_v2_retired/) was created
# and silently staged for the public repo. Deny the tree; add an exception only
# with a reason.
data/
# Cron log output
logs/
# Local build artifacts
*.zip

# ── Internal-only docs ───────────────────────────────────────────────────────
# Everything internal now lives under docs/: plans/, releases/, archive/, plus
# the pipeline and schema references. One rule covers the lot.
docs/
# Engineering log, kept at root beside the public CHANGELOG
DEVLOG.md
# Safety net: a plan file recreated at root stays out of the public repo
*_PLAN.md
# Agent working instructions
CLAUDE.md
.github/copilot-instructions.md

# ── Pipeline scripts with VPS paths ──────────────────────────────────────────
scripts/backfill_csvs.py
scripts/update_csvs.py
scripts/ingest_buckets.py
# Pipeline data used by excluded scripts
scripts/coin_universe.json

# ── Server config ────────────────────────────────────────────────────────────
nginx/

# ── Source assets not needed in repo ─────────────────────────────────────────
extension/icons/instrumetriq-avatar.jpg
extension/icons/Screenshot*
promo-tile-*.jpg
promo-tile-*.png

# ── Screenshot harness: browser + outputs, see tools/screenshot/README.md ─────
tools/screenshot/chrome/
tools/screenshot/build/
tools/screenshot/out/
tools/screenshot/store/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/

# ── Temporary / debug ────────────────────────────────────────────────────────
tmp/
scripts/_test_*

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
*.swp
*.swo
